# Copy this file to ".env" and fill in your Spotify app's Client ID.
#
# Get a Client ID (free, ~3 min):
#   1. Go to  https://developer.spotify.com/dashboard  and log in.
#   2. Click "Create app".
#        App name:     Hitster Home    (anything)
#        Description:  party game      (anything)
#        Redirect URI: http://127.0.0.1:8080/callback     <-- must match exactly
#        API/SDKs:     tick "Web Playback SDK" and "Web API"
#   3. Save, open the app, click "Settings", copy the "Client ID".
#   4. Paste it below. No client secret is needed (we use PKCE).
#
# NOTE: playing full songs requires the person running the jukebox to log in
# with a Spotify *Premium* account.

SPOTIFY_CLIENT_ID=

# Only change these if you run on a different port. The redirect URI MUST be
# added verbatim in your Spotify app settings, and MUST use 127.0.0.1 (not
# "localhost") — that is the only http address Spotify still allows.
PORT=8080
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# ---------------------------------------------------------------------------
# Only needed for the ONE-TIME build step that bakes Spotify track ids into
# data/themes/*.json  (node scripts/resolve-track-ids.js).
#
# Dashboard -> your app -> Settings -> "View client secret".
# This is used by that script alone — the game itself never reads it, and once
# the ids are baked the running game needs no Spotify credentials at all.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Where to tell players to go. Leave blank for a game in one room: the QR code
# then points at this machine's LAN address.
#
# Set it when the server is reachable from outside — e.g. behind a Cloudflare
# tunnel — or remote players get handed a 192.168.x.x they cannot reach. No
# trailing slash.
#
#   PUBLIC_URL=https://hitbeat.example.com
# ---------------------------------------------------------------------------
PUBLIC_URL=
